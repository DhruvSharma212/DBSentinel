DATABASE_URL=postgresql://dbsentinel_user:YOUR_PASSWORD@localhost:5432/dbsentinel
# Shared secret agents send in the X-API-Key header. Generate one, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
INGEST_KEY=change-me
# Comma-separated browser origins allowed to call the API (defaults: the Vercel site + local Vite).
# ALLOWED_ORIGINS=https://db-sentinel.vercel.app,http://localhost:5173
# A device counts as offline when it has not reported for this many seconds.
# OFFLINE_AFTER_SECONDS=15
